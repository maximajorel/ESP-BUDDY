# Credenciales del panel web (esp32_gadget/web_ui).
#
# Copia este archivo a `.env` y pone los valores que quieras. Se usan SOLO para
# sembrar el dispositivo la primera vez: el firmware compila una sal y un hash
# (nunca la contrasena en texto plano) y los guarda en NVS.
#
# Para cambiarlas mas adelante no hace falta recompilar: usa la tarjeta "Cuenta"
# del panel, en /admin.
#
# Despues de editar este archivo:
#     python tools/gen_admin_defaults.py
#
# ADMIN_USER: hasta 32 caracteres ASCII visibles, sin espacios ni : / \ " %
# ADMIN_PASS: entre 8 y 64 caracteres
ADMIN_USER=admin
ADMIN_PASS=cambiame-123
