<!doctype html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="theme-color" content="#ffffff">
<title>{{TITLE}}</title>
<style>
{{CORE}}
</style>
</head>
<body>

<a class="skip" href="#contenido">Saltar al contenido</a>

{{SPRITE}}

<header class="topbar">
