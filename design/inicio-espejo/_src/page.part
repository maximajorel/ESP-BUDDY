<main class="landing" id="contenido">

  <!-- The eyes live on the glass, not here: this page is a control surface. -->
  <header class="hero">
    <div class="stickers" aria-hidden="true">
      <span class="sticker a"><svg viewBox="0 0 24 24"><path d="M12 3c3 2 4.5 5 4.5 9L14 15h-4l-2.5-3C7.5 8 9 5 12 3z"/><path d="M9.5 16.5 7 20l4-1M14.5 16.5 17 20l-4-1"/></svg></span>
      <span class="sticker b"></span>
      <span class="sticker c"></span>
    </div>
    <h1 class="display">ESP-BUDDY</h1>
  </header>

  <div class="statusbar">
    <button class="menu-btn" id="menuBtn" type="button" aria-expanded="{{MENU_EXPANDED}}" aria-controls="launcher" aria-label="Abrir menú">
      <svg aria-hidden="true"><use href="#i-apps"/></svg>
    </button>
  </div>

  <section class="dock" aria-labelledby="screensTitle">
    <div class="dock-head">
      <h2 id="screensTitle">Pantallas</h2>
      <span class="now" id="dockNow">Ahora: RELOJ</span>
    </div>
    <div class="carousel" id="carousel" role="listbox" aria-label="Pantallas del equipo">
      <button class="slide" type="button" role="option" data-screen="0" aria-selected="true" aria-pressed="true">
        <svg aria-hidden="true"><use href="#i-clock"/></svg><span class="num">01</span><b>RELOJ</b>
      </button>
      <button class="slide" type="button" role="option" data-screen="1" aria-selected="false" aria-pressed="false">
        <svg aria-hidden="true"><use href="#i-slot"/></svg><span class="num">02</span><b>TRAGAMONEDAS</b>
      </button>
      <button class="slide" type="button" role="option" data-screen="2" aria-selected="false" aria-pressed="false">
        <svg aria-hidden="true"><use href="#i-rocket"/></svg><span class="num">03</span><b>METEORITOS</b>
      </button>
      <button class="slide" type="button" role="option" data-screen="3" aria-selected="false" aria-pressed="false">
        <svg aria-hidden="true"><use href="#i-wifi"/></svg><span class="num">04</span><b>RED</b>
      </button>
      <button class="slide" type="button" role="option" data-screen="4" aria-selected="false" aria-pressed="false">
        <svg aria-hidden="true"><use href="#i-music"/></svg><span class="num">05</span><b>MUSICA</b>
      </button>
      <button class="slide" type="button" role="option" data-screen="5" aria-selected="false" aria-pressed="false">
        <svg aria-hidden="true"><use href="#i-smile"/></svg><span class="num">06</span><b>SOFIA</b>
      </button>
      <button class="slide" type="button" role="option" data-screen="6" aria-selected="false" aria-pressed="false">
        <svg aria-hidden="true"><use href="#i-settings"/></svg><span class="num">07</span><b>CONFIG</b>
      </button>
    </div>
    <p class="dock-msg" id="dockMsg" role="status" hidden>No pude leer el equipo. <button class="linkish" id="retryBtn" type="button">Reintentar</button></p>
  </section>

  <section class="focus-band" aria-labelledby="focusTitle">
    <div class="section-head">
      <h2 id="focusTitle">Pomodoro</h2>
    </div>
    <div class="focus-card">
      <p class="focus-lead">Sofía se concentra con vos.</p>
      <div class="chips" role="group" aria-label="Duración de la concentración">
        <button class="chip" type="button" data-focus-min="15" aria-pressed="false">15 min</button>
        <button class="chip" type="button" data-focus-min="25" aria-pressed="true">25 min</button>
        <button class="chip" type="button" data-focus-min="45" aria-pressed="false">45 min</button>
        <button class="chip" type="button" data-focus-min="60" aria-pressed="false">60 min</button>
      </div>
      <div class="focus-row">
        <label class="focus-field" for="focusMinutes">Minutos
          <input id="focusMinutes" type="number" min="0" max="99" step="1" value="25" inputmode="numeric">
        </label>
        <label class="focus-field" for="focusSeconds">Segundos
          <input id="focusSeconds" type="number" min="0" max="59" step="1" value="0" inputmode="numeric">
        </label>
        <button class="btn solid" id="focusStart" type="button">Arrancar</button>
        <button class="btn ghost" id="focusStop" type="button" hidden>Cancelar</button>
      </div>
      <p class="focus-now" id="focusNow" role="status" hidden></p>
    </div>
  </section>

  <section class="games" aria-labelledby="gamesTitle">
    <div class="section-head">
      <h2 id="gamesTitle">Juegos</h2>
    </div>
    <button class="cover" type="button" data-open-game>
      <span class="cover-tag">1v1 contra Sofía</span>
      <h3>Ta-te-ti</h3>
      <p>Elegí dificultad y jugá. Tres niveles, del más blando al que no perdona.</p>
      <span class="chips">
        <span class="chip">Fácil</span>
        <span class="chip">Normal</span>
        <span class="chip">Difícil</span>
      </span>
    </button>
  </section>


</main>
