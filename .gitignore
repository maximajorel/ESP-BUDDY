# --- Build outputs -----------------------------------------------------------
# Arduino/arduino-cli build directories (.build-main, .build-clean, ...).
.build-*/
build/
.pio/
.pioenvs/
.piolibdeps/

# --- Vendored upstream SDK ---------------------------------------------------
# Waveshare demo bundle: ESP-IDF, LVGL and firmware blobs (~264 MB). These are
# re-downloadable upstream sources, never project code. Keep _legacy/ itself
# versioned so the prototype lineage and notes survive.
_legacy/waveshare-demo/

# --- Generated artifacts -----------------------------------------------------
*.log
*.o
*.a
*.elf
*.map
*.hex
*.merged.bin
__pycache__/
*.py[cod]

# --- Editor / OS -------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
*.swp
*~
.idea/
.vscode/

# --- Local secrets -----------------------------------------------------------
# Web panel credentials for a build: `.env` holds the owner's user and password,
# and the generated header keeps only a salt and a digest of them. Both are
# per-machine, so neither is versioned; `.env.example` documents the keys.
.env
esp32_gadget/admin_seed.h

# --- Local tooling ----------------------------------------------------------
.codegraph/

# --- Tauri / Rust -----------------------------------------------------------
# El target de Cargo y lo que deja al enlazar. `tray_buddy/.gitignore` ya cubre
# su propio `src-tauri/target/` y `node_modules/`; esto es la red por si alguien
# compila desde la raíz. `Cargo.lock` NO se ignora: es un binario, y el lock es
# parte de la reproducibilidad del build.
target/
*.pdb

# Los BMP del instalador (tray_buddy/installer/) sí se versionan: los genera
# `tools/make_installer_art.py` y `tauri.conf.json` los referencia por ruta, así
# que un clon sin ellos no compila el bundle.

# --- Scratch de verificación ------------------------------------------------
# Copias de `ui/` y capturas para mirar el popover sin compilar. Se recrean a
# mano en cada sesión y nunca son fuente.
.ui-shot/
tb-shots/
*.tmp
